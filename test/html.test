<!-- test: strips basic tags -->
<!-- html -->
<p>Hello <strong>world</strong>!</p>
<!-- out -->
Hello world!

<!-- test: decodes common entities -->
<!-- html -->
a &amp; b &lt; c &gt; d &quot;e&quot; f&apos;g
<!-- out -->
a & b < c > d "e" f'g

<!-- test: nested tags -->
<!-- html -->
<div><p><em>text</em></p></div>
<!-- out -->
text

<!-- test: self-closing tags -->
<!-- html -->
text<br/>more
<!-- out -->
textmore

<!-- test: plain text unchanged -->
<!-- html -->
just plain text
<!-- out -->
just plain text
