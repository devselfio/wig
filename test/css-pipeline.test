<!-- test: simple concatenation -->
<!-- css-files -->
a.css: body { color: red; }
b.css: h1 { font-size: 2em; }
<!-- out -->
body { color: red; }
h1 { font-size: 2em; }

<!-- test: single file passthrough -->
<!-- css-files -->
reset.css: *, *::before { box-sizing: border-box; }
<!-- out -->
*, *::before { box-sizing: border-box; }
